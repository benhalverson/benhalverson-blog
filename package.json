{
	"name": "benhalverson-blog",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"generate:content": "node --disable-warning=ExperimentalWarning --experimental-default-type=module --experimental-strip-types tools/generate-content.ts",
		"prestart": "pnpm run generate:content",
		"start": "ng serve",
		"prebuild": "pnpm run generate:content",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"pretest": "pnpm run generate:content",
		"test": "ng test",
		"serve:ssr:benhalverson-blog": "node dist/benhalverson-blog/server/server.mjs",
		"preview": "pnpm run build && wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"private": true,
	"packageManager": "pnpm@10.23.0",
	"dependencies": {
		"@angular/common": "^21.2.0",
		"@angular/compiler": "^21.2.0",
		"@angular/core": "^21.2.0",
		"@angular/forms": "^21.2.0",
		"@angular/platform-browser": "^21.2.0",
		"@angular/platform-server": "^21.2.15",
		"@angular/router": "^21.2.0",
		"@angular/ssr": "^21.2.3",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"mdast-util-to-string": "^4.0.0",
		"reading-time": "^1.5.0",
		"rehype-highlight": "^7.0.2",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@angular/build": "^21.2.3",
		"@angular/cli": "^21.2.3",
		"@angular/compiler-cli": "^21.2.0",
		"@tailwindcss/postcss": "^4.1.12",
		"@types/node": "^20.17.19",
		"jsdom": "^28.0.0",
		"postcss": "^8.5.3",
		"prettier": "^3.8.1",
		"tailwindcss": "^4.1.12",
		"typescript": "~5.9.2",
		"vitest": "^4.0.8",
		"wrangler": "^4.77.0",
		"xhr2": "^0.2.1"
	}
}
